# Example .env file for web Firebase configuration
# Copy this to .env and fill in values for your Firebase Web app.

# REQUIRED for web Firebase (used by lib/services/firebase_options.dart)
WEB_API_KEY=your-web-api-key
WEB_APP_ID=your-web-app-id
WEB_PROJECT_ID=your-web-project-id
WEB_AUTH_DOMAIN=your-project.firebaseapp.com
WEB_MESSAGING_SENDER_ID=your-messaging-sender-id
WEB_STORAGE_BUCKET=your-project.appspot.com
WEB_MEASUREMENT_ID=G-measurement-id

# Google Sign-In web client id (optional if you add meta tag to web/index.html)
WEB_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Fallback
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
